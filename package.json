{
  "name": "@shareai-lab/kode",
  "version": "2.2.0",
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "kode": "cli.js",
    "kwa": "cli.js",
    "kd": "cli.js",
    "mcp-cli": "mcp-cli.js",
    "kode-acp": "cli-acp.js"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "main": "cli.js",
  "exports": {
    ".": {
      "require": "./cli.js",
      "default": "./cli.js"
    },
    "./protocol": {
      "import": "./dist/sdk/protocol.js",
      "require": "./dist/sdk/protocol.cjs"
    },
    "./daemon-client": {
      "import": "./dist/sdk/daemon-client.js",
      "require": "./dist/sdk/daemon-client.cjs"
    }
  },
  "author": "ShareAI-lab <ai-lab@foxmail.com>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "AI-powered terminal assistant that understands your codebase, edits files, runs commands, and automates development workflows.",
  "homepage": "https://github.com/shareAI-lab/Kode-CLI",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shareAI-lab/Kode-CLI.git"
  },
  "bugs": {
    "url": "https://github.com/shareAI-lab/Kode-CLI/issues"
  },
  "files": [
    "cli.js",
    "cli-acp.js",
    "mcp-cli.js",
    "yoga.wasm",
    "dist/**/*",
    "!dist/bin/**",
    "!dist/binary/**",
    "packages/builtin-skills/THIRD_PARTY_NOTICES.md",
    "packages/builtin-skills/skills/**/*",
    "packages/builtin-skills/third_party/shareai-skills/LICENSE",
    "scripts/cli-wrapper.cjs",
    "scripts/cli-acp-wrapper.cjs"
  ],
  "scripts": {
    "dev": "bun run ./apps/cli/src/dispatch.ts --verbose",
    "dev:cli": "bun run ./apps/cli/src/dispatch.ts --verbose",
    "dev:server": "bun run --filter @kode/server dev",
    "dev:web": "bun run --filter @kode/web dev",
    "dev:bun": "bun run ./apps/cli/src/dispatch.ts --verbose",
    "build:cli": "node scripts/build-cli.mjs",
    "build:server": "node scripts/build-server.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build": "bun run scripts/build.mjs",
    "build:binary": "bun run scripts/build-binary.mjs",
    "clean": "bun run scripts/clean.mjs",
    "prepublishOnly": "bun run scripts/build.mjs && bun run scripts/prepublish-check.js",
    "format": "prettier --write \"*.{md,json,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"apps/**/*.{ts,tsx,js,jsx,json,md,css,html}\" \"packages/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"docs/**/*.{md,json}\"",
    "format:check": "prettier --check \"*.{md,json,yml,yaml}\" \".github/**/*.{md,yml,yaml}\" \"apps/**/*.{ts,tsx,js,jsx,json,md,css,html}\" \"packages/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,mjs,cjs,json}\" \"docs/**/*.{md,json}\"",
    "architecture:check": "node scripts/check-architecture.mjs",
    "security:audit": "bun audit --audit-level=high",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run format:check && bun run architecture:check && bun run security:audit && bun run typecheck && bun test && bun run build",
    "prepare": "node scripts/install-hooks.mjs",
    "bench:startup": "bun run scripts/bench-startup.mjs"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.12.6",
    "@anthropic-ai/sdk": "^0.39.0",
    "@anthropic-ai/vertex-sdk": "^0.7.0",
    "@aws-sdk/client-bedrock-runtime": "^3.1119.0",
    "@commander-js/extra-typings": "^13.1.0",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/lodash-es": "^4.17.12",
    "@types/react": "19.2.9",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.0.0",
    "chalk": "^5.4.1",
    "cli-highlight": "^2.1.11",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "debug": "^4.4.1",
    "diff": "^8.0.3",
    "dotenv": "^16.6.1",
    "env-paths": "^3.0.0",
    "fflate": "^0.8.2",
    "figures": "^6.1.0",
    "glob": "^13.0.6",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.5",
    "ink": "6.6.0",
    "ink-link": "^4.1.0",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "js-yaml": "^4.3.2",
    "lodash-es": "^4.18.1",
    "lru-cache": "^11.1.0",
    "marked": "^15.0.12",
    "minimatch": "^10.2.6",
    "nanoid": "^5.1.16",
    "node-html-parser": "^7.0.1",
    "openai": "^4.104.0",
    "react": "19.2.3",
    "react-reconciler": "0.33.0",
    "semver": "^7.7.2",
    "shell-quote": "^1.10.0",
    "spawn-rx": "^5.1.2",
    "string-width": "^7.2.0",
    "strip-ansi": "^7.1.0",
    "tsx": "^4.20.3",
    "turndown": "^7.2.0",
    "undici": "^7.29.0",
    "which": "^5.0.0",
    "wrap-ansi": "^9.0.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  },
  "optionalDependencies": {
    "@shareai-lab/kode-bin-darwin-arm64": "2.2.0",
    "@shareai-lab/kode-bin-darwin-x64": "2.2.0",
    "@shareai-lab/kode-bin-linux-arm64": "2.2.0",
    "@shareai-lab/kode-bin-linux-x64": "2.2.0",
    "@shareai-lab/kode-bin-win32-arm64": "2.2.0",
    "@shareai-lab/kode-bin-win32-x64": "2.2.0",
    "@shareai-lab/kode-ripgrep-darwin-arm64": "2.2.0",
    "@shareai-lab/kode-ripgrep-darwin-x64": "2.2.0",
    "@shareai-lab/kode-ripgrep-linux-arm64": "2.2.0",
    "@shareai-lab/kode-ripgrep-linux-x64": "2.2.0",
    "@shareai-lab/kode-ripgrep-win32-arm64": "2.2.0",
    "@shareai-lab/kode-ripgrep-win32-x64": "2.2.0"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.10",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.3.4",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.19",
    "@types/bun": "1.3.6",
    "@types/node": "^24.1.0",
    "@types/which": "^3.0.4",
    "@uiw/react-codemirror": "^4.24.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.21",
    "bun-types": "1.3.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.9",
    "lucide-react": "^0.542.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "react-devtools-core": "6.1.5",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.5",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.12",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.2",
    "vite": "^7.3.6"
  },
  "overrides": {
    "@aws-sdk/client-bedrock-runtime": "$@aws-sdk/client-bedrock-runtime"
  }
}
